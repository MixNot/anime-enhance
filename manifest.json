{
  "manifest_version": 3,
  "name": "Anime Enhance — шейдеры для аниме",
  "version": "0.2.0",
  "description": "Отдельное расширение для улучшения изображения в плеерах AnimeLib. Anime4K, ручной выбор режима и сравнение с оригиналом.",
  "minimum_chrome_version": "113",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Anime Enhance",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://animelib.org/*",
        "https://kodikplayer.com/*",
        "https://*.kodikplayer.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
